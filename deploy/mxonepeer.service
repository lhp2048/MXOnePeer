[Unit]
Description=MXOnePeer
After=network-online.target
Wants=network-online.target

[Service]
User=mxonepeer
Group=mxonepeer
WorkingDirectory=/var/lib/mxonepeer
Environment=PYTHONPATH=/opt/mxonepeer
Environment=TS_RS_EXPERIMENT=this_is_unstable_software
EnvironmentFile=/etc/mxonepeer.env
ExecStart=/opt/mxonepeer/venv/bin/python -m mxonepeer --state-dir /var/lib/mxonepeer --port 18020
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
