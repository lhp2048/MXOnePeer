[Unit]
Description=MXOnePeer
After=network-online.target
Wants=network-online.target

[Service]
User=mxonepeer
Group=mxonepeer
WorkingDirectory=/var/lib/mxonepeer
EnvironmentFile=/etc/mxonepeer.env
ExecStart=/opt/mxonepeer/mxonepeer --hostname mxonepeer --state-dir /var/lib/mxonepeer --port 18020 --admin-host 127.0.0.1 --admin-port 8788
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
